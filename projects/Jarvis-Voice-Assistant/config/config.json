{
  "_comment": "Jarvis 统一配置文件",

  "stt": {
    "provider": "capswriter",
    "local": {
      "model": "sensevoice",
      "vad_threshold": 0.02,
      "silence_seconds": 1.2,
      "min_audio_seconds": 0.5
    },
    "api": {
      "provider": "openai",
      "api_key": "",
      "model": "whisper-1"
    }
  },

  "llm": {
    "provider": "api",
    "api": {
      "provider": "deepseek",
      "api_key": "",
      "base_url": "https://api.deepseek.com/v1",
      "model": "deepseek-chat",
      "max_tokens": 512,
      "temperature": 0.3,
      "history_turns": 6
    },
    "local": {
      "provider": "ollama",
      "host": "http://localhost:11434",
      "model": "qwen2.5:7b"
    }
  },

  "tts": {
    "provider": "edge",
    "edge": {
      "voice": "zh-CN-XiaoxiaoNeural",
      "rate": 0
    },
    "local": {
      "provider": "cosyvoice",
      "host": "http://localhost:5000"
    }
  },

  "ahk": {
    "software_cache": "config/software_cache.json",
    "actions": "config/actions.json"
  },

  "memory": {
    "short_term_turns": 10,
    "summary_frequency": "daily"
  },

  "ui": {
    "theme": "dark",
    "opacity": 0.8,
    "position": "center"
  }
}
